{
  "name": "truco-argentino",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "core",
    "server",
    "client"
  ],
  "scripts": {
    "test": "npm run test --workspace=core",
    "build": "npm run build --workspaces",
    "build:server": "npm run build --workspace=@truco/core && npm run build --workspace=@truco/server",
    "start:server": "node server/dist/server.js",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev": "npm run dev:client"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
